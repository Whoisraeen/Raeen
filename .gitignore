# Build artifacts
/target/
**/*.rs.bk

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Environment
.env
.env.local

# Shader cache (generated at runtime)
shader_cache/

# User configuration (generated at runtime)
config.toml

# Game data (user-provided) — proprietary titles the user owns; NEVER commit
# (clean-room boundary). Both cases listed explicitly: the canonical path is
# `Games/<name>/eboot.bin` (CLAUDE.md), and a bare `games/` matched only by
# accident of Windows' case-insensitive filesystem — it would NOT match on a
# case-sensitive host (Linux, or a moved repo).
Games/
games/
firmware/
savedata/
.PS5 Firmware/
.PS5 Games/
PS5 Firmware/

# Logs
logs/
*.log

# User-installed Shell themes (spec `2026-07-13-xps5x-shell-design.md`
# §6/§11): the default theme's manifest is original content and ships in
# the repo, but everything else under themes/ is either a user-installed
# theme or user-supplied binary assets (fonts, backgrounds, icons) and must
# never be committed.
themes/*
!themes/default/
!themes/default/theme.toml

# Claude Code worktrees / local scratch (never commit embedded git repos)
.claude/worktrees/

# Third-party reference sources — cloned locally for study/porting only
# (e.g. Kyty, MIT). NEVER committed: we re-implement in Rust from these,
# with attribution in THIRD_PARTY_NOTICES.md, never vendoring their trees.
reference/

#AI
.claude/
Claude.md
.claude/skills
.agents
.claude/agents
.codex/
Agents.md
# Diagnostic image written by xps5x-gpu's `dump_triangle_image` test
# (override the path with XPS5X_TRIANGLE_PPM). A build artifact, not source.
triangle.ppm
*.ppm
scratch/
