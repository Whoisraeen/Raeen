# Build artifacts
/target/
**/*.rs.bk

# Installer packaging outputs, and the bundled Microsoft VC++ redist
# (fetched at package time — see installer/redist/README.md, never committed).
# The generated branding under installer/assets/ IS committed so the .iss
# opens standalone in the Inno Setup IDE.
/dist/
installer/redist/*.exe

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Environment
.env
.env.local

# Shader cache (generated at runtime)
shader_cache/

# Compatibility runner evidence is machine-local and may contain proprietary
# paths or logs. Only sanitized, measured summaries are publishable.
artifacts/
compat/local/

# User configuration (generated at runtime)
config.toml

# Per-game settings overrides (generated at runtime by the Shell's Game Options
# overlay; machine-local, keyed by title id — never commit)
per_game/

# Game data (user-provided) — proprietary titles the user owns; NEVER commit
# (clean-room boundary). Both cases listed explicitly: the canonical path is
# `Games/<name>/eboot.bin` (CLAUDE.md), and a bare `games/` matched only by
# accident of Windows' case-insensitive filesystem — it would NOT match on a
# case-sensitive host (Linux, or a moved repo).
Games/
games/
firmware/
savedata/
.PS5 Firmware/
.PS5 Games/
PS5 Firmware/

# Logs
logs/
*.log

# User-installed Shell themes (spec `2026-07-13-raeen-shell-design.md`
# §6/§11): the default theme's manifest is original content and ships in
# the repo, but everything else under themes/ is either a user-installed
# theme or user-supplied binary assets (fonts, backgrounds, icons) and must
# never be committed.
themes/*
!themes/default/
!themes/default/theme.toml

# Claude Code worktrees / local scratch (never commit embedded git repos)
.claude/worktrees/

# Third-party reference sources — cloned locally for study/porting only
# (e.g. Kyty, MIT). NEVER committed: we re-implement in Rust from these,
# with attribution in THIRD_PARTY_NOTICES.md, never vendoring their trees.
reference/

# Out-of-tree / BYO present plugins (upscalers, frame-gen). Proprietary
# plugins — e.g. an NVIDIA DLSS/Streamline shim — implement the vendor-neutral
# `raeen_gpu::present_plugin` ABI but are NEVER distributed by Raeen: they are
# hosted separately and dropped in here by a user. Everything under plugins/ is
# ignored except the committed README that documents the boundary.
/plugins/*
!/plugins/README.md

#AI
.claude/
Claude.md
.claude/skills
.agents
.claude/agents
.codex/
Agents.md
# Diagnostic image written by raeen-gpu's `dump_triangle_image` test
# (override the path with RAEEN_TRIANGLE_PPM). A build artifact, not source.
triangle.ppm
*.ppm
scratch/

# Session ledger — per-game play-session records written at runtime
# (e.g. session_ledger/ASTRO.BOT.json); machine-local user data, never commit.
session_ledger/

# Screenshots captured with F12 / the pad Create button — frames of the
# user's own (possibly proprietary) titles; machine-local, never commit.
screenshots/
